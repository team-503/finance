{
    "$schema": "https://swc.rs/schema.json",
    "sourceMaps": true,
    "minify": false,
    "module": {
        "type": "es6"
    },
    "jsc": {
        "target": "es2023",
        "baseUrl": "./",
        "parser": {
            "syntax": "typescript",
            "decorators": true,
            "dynamicImport": true
        },
        "transform": {
            "legacyDecorator": true,
            "decoratorMetadata": true
        }
    }
}
