{
    "name": "api",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "scripts": {
        "generate:config-schema": "node scripts/generate-config-schema.ts && prettier --write schemas/config.schema.json",
        "build": "nest build",
        "dev": "nest start --watch",
        "start": "node dist/main.js",
        "lint": "eslint . --max-warnings 0",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@nestjs/common": "12.0.1",
        "@nestjs/core": "12.0.1",
        "@nestjs/platform-express": "12.0.1",
        "@nestjs/terminus": "11.1.1",
        "@nestjs/throttler": "6.5.0",
        "@repo/types": "workspace:*",
        "bytes": "3.1.2",
        "config": "5.0.1",
        "dotenv": "17.4.2",
        "ms": "2.1.3",
        "nestjs-pino": "4.6.1",
        "pino": "10.3.1",
        "pino-http": "11.0.0",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "yaml": "2.9.0",
        "zod": "4.5.4"
    },
    "devDependencies": {
        "@nestjs/cli": "12.0.0",
        "@nestjs/schematics": "12.0.0",
        "@nestjs/testing": "12.0.1",
        "@repo/eslint-config": "workspace:*",
        "@repo/typescript-config": "workspace:*",
        "@swc/cli": "0.8.1",
        "@swc/core": "1.16.1",
        "@types/bytes": "3.1.6",
        "@types/express": "5.0.6",
        "@types/ms": "2.1.0",
        "@types/node": "26.4.0",
        "eslint": "10.9.1",
        "pino-pretty": "13.1.3",
        "prettier": "3.9.6",
        "typescript": "6.0.3",
        "vite-tsconfig-paths": "6.1.1",
        "vitest": "4.1.11"
    }
